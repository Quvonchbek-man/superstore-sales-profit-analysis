		annotation SummarizationSetBy = Automatic

	column 'Product key'
		dataType: string
		lineageTag: 9b6227dd-2047-45be-b7c5-1d3475af75a0
		summarizeBy: none
		sourceColumn: Product key

		annotation SummarizationSetBy = Automatic

	partition Products = m
		mode: import
		source =
				let
				    Source = Staging,
				    #"Removed Other Columns" = Table.SelectColumns(Source,{"Product ID", "Product Name", "Category", "Sub-Category", "Product key"}),
				    #"Removed Duplicates" = Table.Distinct(#"Removed Other Columns")
				in
				    #"Removed Duplicates"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

