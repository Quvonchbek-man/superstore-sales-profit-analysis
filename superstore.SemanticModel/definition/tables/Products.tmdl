table Products
	lineageTag: cef2ea97-f9a5-4b8a-bdd1-cd97838ca3a2

	measure 'Top Product Title' =
			
			VAR SelYear   = SELECTEDVALUE( 'Date'[Year] )
			VAR TopTable  = TOPN( 1, VALUES( Products[Product Name] ), [Total Profit], DESC )
			VAR TopName   = CONCATENATEX( TopTable, Products[Product Name] )
			VAR TopProfit = MAXX( TopTable, [Total Profit] )
			RETURN
			    "Top product in " & SelYear & ": " & TopName
			        & " (" & FORMAT( TopProfit, "$#,0" ) & ")"
		lineageTag: 5f9bfd30-89ae-4bee-9ad8-74afcf807461

	measure 'Bottom Product Title' =
			
			VAR SelYear    = SELECTEDVALUE( 'Date'[Year] )
			VAR Sold       = FILTER( VALUES( Products[Product Name] ), NOT ISBLANK( [Total Profit] ) )
			VAR BotTable   = TOPN( 1, Sold, [Total Profit], ASC )
			VAR BotName    = CONCATENATEX( BotTable, Products[Product Name] )
			VAR BotProfit  = MAXX( BotTable, [Total Profit] )
			RETURN
			    "Biggest loss in " & SelYear & ": " & BotName
			        & " (" & FORMAT( BotProfit, "$#,0" ) & ")"
		lineageTag: 8a2f7129-7eaf-41c5-a922-81383c8505c2

	column 'Product ID'
		dataType: string
		lineageTag: ce527143-bca6-4b95-817a-1e8845bf49cf
		summarizeBy: none
		sourceColumn: Product ID

		annotation SummarizationSetBy = Automatic

	column 'Product Name'
		dataType: string
		lineageTag: 494df508-de37-4df8-8e62-36cfa67af577
