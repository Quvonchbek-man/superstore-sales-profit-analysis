	partition Sales = m
		mode: import
		source =
				let
				    Source = Staging,
				    #"Reordered Columns" = Table.ReorderColumns(Source,{"Row ID", "Order ID", "Order Date", "Ship Date", "Customer ID", "Product key", "CIty_state", "Ship Mode", "Sales", "Profit", "Quantity", "Ship days", "Discount", "Segment", "Country", "City", "State", "Region", "Product ID", "Product Name", "Category", "Sub-Category"}),
				    #"Removed Other Columns" = Table.SelectColumns(#"Reordered Columns",{"Discount", "Ship days", "Quantity", "Profit", "Sales", "Ship Mode", "CIty_state", "Product key", "Customer ID", "Ship Date", "Order Date", "Order ID", "Row ID"})
				in
				    #"Removed Other Columns"

	annotation PBI_NavigationStepName = Navigation

