table Sales
	lineageTag: e86ea079-c57a-4c9d-beac-c74ad3784b51

	measure 'Total Sales' = SUM(Sales[Sales])
		formatString: \$#,0;-\$#,0;\$#,0
		lineageTag: f1417a62-bc6d-4cf9-b879-dbca7cf5ab95

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Total Profit' = SUM(Sales[Profit])
		formatString: \$#,0;-\$#,0;\$#,0
		lineageTag: 207fe2a9-f8d3-421b-a7ce-d370dc528824

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Profit Margin' = DIVIDE([Total Profit], [Total Sales])
		formatString: 0.0%
		lineageTag: 9f3abb07-c7eb-4545-be3d-f339b63453ef

		annotation PBI_FormatHint = {"isCustom":true}

	measure Orders = DISTINCTCOUNT(Sales[Order ID])
		formatString: #,0
		lineageTag: 8b88d631-54be-4d54-83ae-c8f24ee56c90

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Sales LY' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: \$#,0;-\$#,0;\$#,0
		lineageTag: 39af5b62-42f6-4f21-aca9-e134e8432ae5

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Sales YoY %' = DIVIDE([Total Sales] - [Sales LY], [Sales LY])
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		lineageTag: 978c34ba-cc90-4dc4-993b-e26e5b83e5fc

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Profit LY' = CALCULATE([Total Profit],SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: \$#,0;-\$#,0;\$#,0
		lineageTag: d3fd9ffa-53ff-42ca-9453-24951892edca

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Profit YoY %' = DIVIDE([Total Profit]-[Profit LY],[Profit LY])
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		lineageTag: d3564fd7-fbbb-4906-af2b-906cc652e03e

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Avg Discount' = AVERAGE(Sales[Discount])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 29d77b10-7595-4cc6-b52a-bf6fa9ee4003

	measure 'Trend Subtitle' =
			
			VAR Yil = SELECTEDVALUE( 'Date'[Year], "all years" )
			VAR Oylar = [Months Ahead]
			RETURN
			    "Monthly sales, " & Yil & " vs last year"
			        & IF(
			            NOT( ISBLANK( Oylar ) ),
			            " · " & Yil & " ahead in " & Oylar & " of 12 months"
			        )
		lineageTag: 088527f7-28d6-46dd-9347-7492fb9e8389

	measure 'Months Ahead' =
			
			COUNTROWS(
			    FILTER(
			        VALUES( 'Date'[Month No] ),
			        NOT( ISBLANK( [Sales LY] ) ) && [Total Sales] > [Sales LY]
			    )
			)
		formatString: 0
		lineageTag: 7cd1b00f-e77c-439b-a17c-83fff1afd82c

	measure 'Loss Subcats Title' =
			
			VAR SelYear = SELECTEDVALUE( 'Date'[Year] )
			VAR Losers  = FILTER( VALUES( Products[Sub-Category] ), [Total Profit] < 0 )
			VAR List    = CONCATENATEX( Losers, Products[Sub-Category], ", " )
			RETURN
			    IF( ISBLANK( List ) || List = "",
			        "No sub-category lost money in " & SelYear,
			        "Loss-making in " & SelYear & ": " & List )
		lineageTag: 44f10c23-41bb-4b0b-ad6e-3634dc1b697c

	measure 'Orders LY' = CALCULATE([Orders], SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: #,0
		lineageTag: ede0b94e-9d38-49be-8da9-ab7ea11833fb

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Orders YoY %' = DIVIDE([Orders]-[Orders LY],[Orders LY])
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		lineageTag: 6a9e9d94-df7d-4ea4-9bc8-4e707692f629

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Margin LY' = CALCULATE([Profit Margin], SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: 0.0%
		lineageTag: 27509028-f9b3-4834-bd23-c0eae7f8e140

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Margin Change pp' =
			
			IF( ISBLANK( [Margin LY] ), BLANK(), ( [Profit Margin] - [Margin LY] ) * 100 )
		formatString: ▲ 0.0" pp";▼ 0.0" pp";0.0" pp"
		lineageTag: f05bfde0-dc7b-4d4e-a3d4-d115acb1fefb

		annotation PBI_FormatHint = {"isCustom":true}

